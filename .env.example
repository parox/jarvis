# Frontend options only. Copy to .env.local; never put API keys here.
# VITE_TTS_ENGINE=system
# VITE_KOKORO_VOICE=bm_george
# VITE_USE_ELEVENLABS=false
# VITE_PICOVOICE_ACCESS_KEY= # optional browser wake-word provider credential
#
# Bridge options: export in the shell BEFORE npm start (not in .env.local).
# PORT=5173
# JARVIS_BRIDGE_PORT=8787
# OPENAI_API_KEY= # required; server environment only
# JARVIS_MODEL=gpt-6-astra
# JARVIS_EFFORT=medium
# ELEVENLABS_API_KEY= # optional; speech is sent to ElevenLabs
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# JARVIS_ENABLE_CHROME=0 # opt-in read access to logged-in Chrome pages
# JARVIS_ENABLE_CAMERA=0 # opt-in sending camera frames to the model
# JARVIS_FILE_ROOTS= # absolute paths; replaces workspace default
#
# No unrestricted writes, direct API mode, remote origins or automatic MCP import.
# See SECURITY.md for .jarvis/mcp.json and limits of application-level isolation.
